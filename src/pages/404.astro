---
import Base from "../layouts/Base.astro";
import { PATHS, englishAvailable } from "../lib/i18n";
---

<Base title="Nie ma takiej strony" noindex>
  <section class="section">
    <div class="wrap narrow">
      <h1>Nie ma takiej strony</h1>
      <p>Mogła zostać przeniesiona albo w adresie jest literówka.</p>
      <p>
        <a class="btn" href={PATHS.home.pl}>
          Wróć na stronę główną
        </a>
      </p>
      {englishAvailable() && (
        <p lang="en">
          Not found. <a href={PATHS.home.en}>English version</a>.
        </p>
      )}
    </div>
  </section>
</Base>
