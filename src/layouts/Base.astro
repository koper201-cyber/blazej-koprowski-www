---
import "../styles/theme.css";
import "../styles/elevate.css";
import "../styles/sales.css";
import { getImage } from "astro:assets";
import { loadSite, todayInPoland } from "../lib/load-site";
import { buildViewModel } from "../lib/view-model";
import { serializeJsonLd } from "../lib/safe-html";
import { resolveImage } from "../lib/images";
import { isPreview, previewBranch } from "../lib/env";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
}

const site = loadSite();
const { data } = site;
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} · ${data.site.name}` : data.seo.title;
const pageDescription = description ?? data.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const ogSource = resolveImage(
  site.imagesDir,
  data.seo.image ?? data.hero.image,
);
const ogImage = ogSource
  ? await getImage({ src: ogSource, width: 1200, format: "jpg" })
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site).href : undefined;

const { nav, ctaLink, visible } = buildViewModel(
  data,
  site.sections,
  todayInPoland(),
);
const mobileContact = Boolean(data.sales?.mobile_contact && visible.contact);
const isElevate = data.site.theme === "elevate";
const headerCtaLink = ctaLink?.startsWith("#") ? `/${ctaLink}` : ctaLink;
const initials = data.site.name
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join("");
---

<!doctype html>
<html lang={data.site.language} data-theme={data.site.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta name="theme-color" content={data.site.primary_color} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={data.site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />

    <style
      is:inline
      set:html={`:root{--primary:${data.site.primary_color};}`}
    ></style>
    {jsonLd.map((obj) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(obj)}
      />
    ))}
  </head>
  <body class:list={[{ "has-mobile-contact": mobileContact }]}>
    {isPreview && (
      <div class="preview-banner" role="status">
        <strong>PODGLĄD</strong> — ta wersja nie jest jeszcze opublikowana
        {previewBranch && (
          <span class="preview-branch"> (zmiana: {previewBranch})</span>
        )}
      </div>
    )}
    <a class="skip" href="#tresc">
      Przejdź do treści
    </a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          {isElevate && (
            <span class="brand-mark" aria-hidden="true">
              {initials}
            </span>
          )}
          {data.site.name}
        </a>
        {nav.length > 0 && (
          <nav aria-label="Menu główne">
            <ul>
              {nav.map((n) => (
                <li>
                  <a href={n.href}>{n.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {isElevate && data.hero.cta_label && ctaLink && (
          <a class="btn header-cta" href={headerCtaLink}>
            {data.hero.cta_label}
            <span aria-hidden="true"> ↗</span>
          </a>
        )}
      </div>
    </header>
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          © {new Date().getFullYear()} {data.site.name}
          {data.site.city && ` · ${data.site.city}`}
        </p>
        <p>
          <a href="/polityka-prywatnosci/">Polityka prywatności</a>
          {isElevate && (
            <span class="design-credit">
              Projekt na bazie{" "}
              <a
                href="https://www.figma.com/community/file/1502180307181819798/elevate-agency-ai-landing-page"
                rel="noopener"
                target="_blank"
              >
                Elevate / flowcub
              </a>{" "}
              · adaptacja
            </span>
          )}
        </p>
      </div>
    </footer>
    {mobileContact && (
      <nav class="sales-mobile-contact" aria-label="Szybki kontakt">
        {data.contact.phone && (
          <a href={`tel:${data.contact.phone.replace(/\s+/g, "")}`}>Zadzwoń</a>
        )}
        <a href={`mailto:${data.contact.email}`}>Napisz</a>
      </nav>
    )}
  </body>
</html>
