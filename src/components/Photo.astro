---
/** Zdjęcie z folderu zdjecia/ — automatycznie AVIF/WebP w kilku rozmiarach. */
import { Picture } from "astro:assets";
import { resolveImage } from "../lib/images";

interface Props {
  dir: string;
  name?: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { dir, name, alt = "", widths = [400, 800, 1200], sizes = "(max-width: 700px) 100vw, 600px", eager = false, class: cls } = Astro.props;
const src = resolveImage(dir, name);
---

{
  src && (
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      widths={widths.filter((w) => w <= src.width).length ? widths.filter((w) => w <= src.width) : [src.width]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class={cls}
    />
  )
}
