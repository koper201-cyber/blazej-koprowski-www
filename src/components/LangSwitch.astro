---
import { UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  /** Ta sama strona w każdym języku. */
  links: { code: Locale; href: string }[];
}
const { locale, links } = Astro.props;
const label = UI[locale].languageMenu;
---

{links.length > 1 && (
  <div class="lang-switch" role="group" aria-label={label}>
    <ul>
      {links.map(({ code, href }) => (
        <li>
          <a
            href={href}
            hreflang={code}
            lang={code}
            aria-label={UI[code].switchTo}
            aria-current={code === locale ? "page" : undefined}
            class:list={["lang-flag", { "is-current": code === locale }]}
          >
            {code === "pl" ? (
              <svg
                viewBox="0 0 30 20"
                width="30"
                height="20"
                aria-hidden="true"
                focusable="false"
              >
                <rect width="30" height="10" fill="#fff" />
                <rect y="10" width="30" height="10" fill="#dc143c" />
              </svg>
            ) : (
              <svg
                viewBox="0 0 60 30"
                width="30"
                height="20"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
                focusable="false"
              >
                <clipPath id="flag-gb-all">
                  <path d="M0 0v30h60V0z" />
                </clipPath>
                <clipPath id="flag-gb-diag">
                  <path d="M30 15h30v15zv15H0zH0V0zV0h30z" />
                </clipPath>
                <g clip-path="url(#flag-gb-all)">
                  <path d="M0 0v30h60V0z" fill="#012169" />
                  <path
                    d="M0 0l60 30m0-30L0 30"
                    stroke="#fff"
                    stroke-width="6"
                  />
                  <path
                    d="M0 0l60 30m0-30L0 30"
                    clip-path="url(#flag-gb-diag)"
                    stroke="#c8102e"
                    stroke-width="4"
                  />
                  <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
                  <path
                    d="M30 0v30M0 15h60"
                    stroke="#c8102e"
                    stroke-width="6"
                  />
                </g>
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
