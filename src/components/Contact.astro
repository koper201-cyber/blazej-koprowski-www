---
import type { SiteData } from "../lib/site-schema";
import ElevateBackdrop from "./ElevateBackdrop.astro";
import { PATHS, UI, type Locale } from "../lib/i18n";

interface Props {
  contact: SiteData["contact"];
  elevated?: boolean;
  locale?: Locale;
}
const { contact, elevated = false, locale = "pl" } = Astro.props;
const t = UI[locale];
const socials = [
  ["LinkedIn", contact.linkedin],
  ["Instagram", contact.instagram],
  ["Facebook", contact.facebook],
  ["GitHub", contact.github],
  [t.website, contact.website],
].filter(([, href]) => href) as [string, string][];
const thanksUrl = new URL(PATHS.thanks[locale], Astro.site).href;
---

<section id="kontakt" class="section section-alt" aria-labelledby="kontakt-h">
  {elevated && <ElevateBackdrop variant="contact" />}
  <div class="wrap contact-grid">
    <div>
      <h2 id="kontakt-h">{t.nav.contact}</h2>
      <ul class="contact-list">
        <li>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        {contact.phone && (
          <li>
            <a href={`tel:${contact.phone.replace(/\s+/g, "")}`}>
              {contact.phone}
            </a>
          </li>
        )}
        {contact.address && <li>{contact.address}</li>}
      </ul>
      {socials.length > 0 && (
        <ul class="socials">
          {socials.map(([label, href]) => (
            <li>
              <a href={href} rel="me noopener" target="_blank">
                {label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    {contact.form_key ? (
      <form
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={contact.form_key} />
        <input type="hidden" name="subject" value={t.formSubject} />
        <input type="hidden" name="redirect" value={thanksUrl} />
        <input
          type="checkbox"
          name="botcheck"
          hidden
          aria-hidden="true"
          tabindex="-1"
          autocomplete="off"
        />
        <label>
          {t.formName}
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          {t.formEmail}
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          {t.formMessage}
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button class="btn" type="submit">
          {t.formSubmit}
        </button>
        <p class="form-note">
          {t.formConsent} <a href={PATHS.privacy[locale]}>{t.privacy}</a>.
        </p>
      </form>
    ) : (
      <div class="contact-cta">
        <p>{t.contactNote}</p>
        <a class="btn" href={`mailto:${contact.email}`}>
          {t.writeEmail}
        </a>
      </div>
    )}
  </div>
</section>
